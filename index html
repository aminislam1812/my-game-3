<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Neon Dodge - Hard Game</title>

<style>
*{
    box-sizing:border-box;
    margin:0;
    padding:0;
}

body{
    background:#050510;
    color:white;
    font-family:Arial,sans-serif;
    display:flex;
    justify-content:center;
    align-items:center;
    min-height:100vh;
    overflow:hidden;
}

#gameBox{
    position:relative;
    width:900px;
    max-width:95vw;
}

canvas{
    display:block;
    width:100%;
    background:#080818;
    border:3px solid #00eaff;
    box-shadow:0 0 25px #00eaff;
}

#ui{
    position:absolute;
    top:12px;
    left:15px;
    right:15px;
    display:flex;
    justify-content:space-between;
    font-size:18px;
    font-weight:bold;
    pointer-events:none;
}

#menu{
    position:absolute;
    inset:0;
    display:flex;
    flex-direction:column;
    justify-content:center;
    align-items:center;
    background:rgba(0,0,0,.78);
    text-align:center;
}

#menu h1{
    font-size:48px;
    color:#00eaff;
    text-shadow:0 0 20px #00eaff;
    margin-bottom:15px;
}

#menu p{
    margin:6px;
    color:#ddd;
}

button{
    margin-top:20px;
    padding:13px 30px;
    border:2px solid #00eaff;
    background:#061c25;
    color:#00eaff;
    font-size:18px;
    border-radius:8px;
    cursor:pointer;
}

button:hover{
    background:#00eaff;
    color:#001014;
}
</style>
</head>

<body>

<div id="gameBox">

<canvas id="game" width="900" height="600"></canvas>

<div id="ui">
    <div>🏆 Score: <span id="score">0</span></div>
    <div>⚡ Level: <span id="level">1</span></div>
    <div>💎 Best: <span id="best">0</span></div>
</div>

<div id="menu">
    <h1 id="title">NEON DODGE</h1>
    <p id="message">Survive as long as possible!</p>
    <p>🎮 Move: A/D or ←/→</p>
    <p>⏸ Pause: SPACE</p>
    <button onclick="startGame()">START GAME</button>
</div>

</div>

<script>

const canvas = document.getElementById("game");
const ctx = canvas.getContext("2d");

const scoreText = document.getElementById("score");
const levelText = document.getElementById("level");
const bestText = document.getElementById("best");

const menu = document.getElementById("menu");
const title = document.getElementById("title");
const message = document.getElementById("message");

let keys = {};
let enemies = [];
let particles = [];

let score = 0;
let level = 1;
let gameRunning = false;
let paused = false;

let spawnTimer = 0;
let lastTime = 0;

let best = Number(localStorage.getItem("neonBest")) || 0;
bestText.textContent = best;

const player = {
    x:450,
    y:520,
    w:32,
    h:32,
    speed:7
};


// Keyboard
document.addEventListener("keydown", e => {

    keys[e.key.toLowerCase()] = true;

    if(e.code === "Space"){
        e.preventDefault();

        if(gameRunning){
            paused = !paused;

            if(paused){
                message.textContent = "Game Paused";
                title.textContent = "⏸ PAUSED";
                menu.style.display = "flex";
            }else{
                menu.style.display = "none";
                lastTime = performance.now();
            }
        }
    }
});

document.addEventListener("keyup", e => {
    keys[e.key.toLowerCase()] = false;
});


// Start
function startGame(){

    enemies = [];
    particles = [];

    score = 0;
    level = 1;
    spawnTimer = 0;

    player.x = canvas.width / 2 - player.w/2;

    gameRunning = true;
    paused = false;

    menu.style.display = "none";

    updateUI();

    lastTime = performance.now();
    requestAnimationFrame(gameLoop);
}


// Spawn enemy
function spawnEnemy(){

    const size = 20 + Math.random()*35;

    const types = ["normal","fast","zigzag"];

    let type = types[Math.floor(Math.random()*types.length)];

    enemies.push({
        x:Math.random()*(canvas.width-size),
        y:-size,
        w:size,
        h:size,

        speed:
            type === "fast"
            ? 4 + level*0.45
            : 2.5 + level*0.35,

        type:type,

        angle:Math.random()*Math.PI*2,

        color:
            type === "fast"
            ? "#ff3333"
            : type === "zigzag"
            ? "#ff00ff"
            : "#ff8c00"
    });
}


// Particles
function createParticles(x,y,color){

    for(let i=0;i<10;i++){

        particles.push({
            x:x,
            y:y,
            vx:(Math.random()-.5)*6,
            vy:(Math.random()-.5)*6,
            life:30,
            color:color
        });
    }
}


// Collision
function collision(a,b){

    return (
        a.x < b.x+b.w &&
        a.x+a.w > b.x &&
        a.y < b.y+b.h &&
        a.y+a.h > b.y
    );
}


// Update
function update(dt){

    // Player movement
    if(keys["arrowleft"] || keys["a"]){
        player.x -= player.speed;
    }

    if(keys["arrowright"] || keys["d"]){
        player.x += player.speed;
    }

    // Boundaries
    if(player.x < 0)
        player.x = 0;

    if(player.x + player.w > canvas.width)
        player.x = canvas.width-player.w;


    // Difficulty
    level = Math.floor(score/500)+1;

    // Spawn rate becomes harder
    spawnTimer += dt;

    let spawnRate = Math.max(180, 650 - level*35);

    if(spawnTimer > spawnRate){

        spawnEnemy();

        spawnTimer = 0;

        // Higher levels sometimes spawn extra enemy
        if(level >= 5 && Math.random() < 0.25){
            spawnEnemy();
        }
    }


    // Enemies
    for(let i=enemies.length-1;i>=0;i--){

        let e = enemies[i];

        e.y += e.speed;

        if(e.type === "zigzag"){
            e.angle += 0.08;
            e.x += Math.sin(e.angle)*3;
        }

        if(e.type === "fast"){
            e.y += Math.sin(e.angle)*1.5;
        }

        // Keep enemy inside screen
        if(e.x < 0)
            e.x = 0;

        if(e.x + e.w > canvas.width)
            e.x = canvas.width-e.w;


        // Collision
        if(collision(player,e)){

            createParticles(
                player.x+player.w/2,
                player.y+player.h/2,
                "#00eaff"
            );

            gameOver();
            return;
        }


        // Enemy escaped
        if(e.y > canvas.height){

            enemies.splice(i,1);

            score += 20;
        }
    }


    // Score automatically increases
    score += dt * 0.01;


    // Particles
    for(let i=particles.length-1;i>=0;i--){

        let p = particles[i];

        p.x += p.vx;
        p.y += p.vy;
        p.life--;

        if(p.life <= 0)
            particles.splice(i,1);
    }

    updateUI();
}


// Draw background
function drawBackground(){

    ctx.fillStyle="#080818";
    ctx.fillRect(0,0,canvas.width,canvas.height);

    // Grid
    ctx.strokeStyle="rgba(0,234,255,.08)";
    ctx.lineWidth=1;

    for(let x=0;x<canvas.width;x+=45){

        ctx.beginPath();
        ctx.moveTo(x,0);
        ctx.lineTo(x,canvas.height);
        ctx.stroke();
    }

    for(let y=0;y<canvas.height;y+=45){

        ctx.beginPath();
        ctx.moveTo(0,y);
        ctx.lineTo(canvas.width,y);
        ctx.stroke();
    }
}


// Draw player
function drawPlayer(){

    ctx.save();

    ctx.shadowBlur=25;
    ctx.shadowColor="#00eaff";

    ctx.fillStyle="#00eaff";

    ctx.beginPath();

    ctx.moveTo(
        player.x+player.w/2,
        player.y
    );

    ctx.lineTo(
        player.x+player.w,
        player.y+player.h
    );

    ctx.lineTo(
        player.x,
        player.y+player.h
    );

    ctx.closePath();

    ctx.fill();

    ctx.restore();
}


// Draw enemies
function drawEnemies(){

    enemies.forEach(e=>{

        ctx.save();

        ctx.shadowBlur=20;
        ctx.shadowColor=e.color;

        ctx.fillStyle=e.color;

        ctx.fillRect(
            e.x,
            e.y,
            e.w,
            e.h
        );

        ctx.restore();
    });
}


// Draw particles
function drawParticles(){

    particles.forEach(p=>{

        ctx.globalAlpha=p.life/30;

        ctx.fillStyle=p.color;

        ctx.fillRect(
            p.x,
            p.y,
            4,
            4
        );
    });

    ctx.globalAlpha=1;
}


// Main loop
function gameLoop(time){

    if(!gameRunning || paused)
        return;

    const dt = time-lastTime;

    lastTime=time;

    update(dt);

    drawBackground();
    drawPlayer();
    drawEnemies();
    drawParticles();

    requestAnimationFrame(gameLoop);
}


// Game over
function gameOver(){

    gameRunning=false;

    if(Math.floor(score)>best){

        best=Math.floor(score);

        localStorage.setItem(
            "neonBest",
            best
        );
    }

    bestText.textContent=best;

    title.textContent="💥 GAME OVER";

    message.innerHTML=
        "Your Score: <b>"+Math.floor(score)+
        "</b><br>Level Reached: <b>"+level+"</b>";

    menu.style.display="flex";
}


// UI
function updateUI(){

    scoreText.textContent=Math.floor(score);
    levelText.textContent=level;
    bestText.textContent=best;
}


// Initial screen
drawBackground();

</script>

</body>
</html>
